
# Supabase Configuration
# Get these values from your Supabase project settings (https://supabase.com/dashboard)
# Go to: Project Settings > API

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Your Supabase anonymous/public API key
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Instructions:
# 1. Copy this file and rename it to .env
# 2. Fill in your Supabase URL and Anon Key
# 3. Restart your Expo development server (npm run dev)
# 4. The app will automatically connect to your Supabase project
